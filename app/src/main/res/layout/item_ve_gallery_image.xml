<?xml version="1.0" encoding="utf-8"?>
<!-- One image tile of the sticker gallery picker: SQUARE rounded thumb with
     the same insets as the folder tiles; the check badge + dimmed thumb mark
     the single selection (OK-confirm flow). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="2dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="8dp">

    <com.goodwy.commons.views.MySquareImageView
        android:id="@+id/ve_image_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ve_card_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        tools:background="#333" />

    <ImageView
        android:id="@+id/ve_image_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:padding="3dp"
        android:src="@drawable/ic_check_vector"
        android:visibility="gone" />
</FrameLayout>
