<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.goodwy.commons.views.MyViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/bottom_actions"
        layout="@layout/bottom_actions" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gallery_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gallery_strip_height"
        android:layout_above="@id/bottom_actions"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/gradient_background"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="@dimen/gallery_strip_padding_vertical"
        android:paddingBottom="@dimen/gallery_strip_padding_vertical"
        android:scrollbars="none"
        android:visibility="gone"
        tools:listitem="@layout/item_gallery_strip"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/top_shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="@dimen/default_status_action_height"
        android:layout_alignBottom="@id/medium_viewer_appbar"
        android:layout_alignParentTop="true"
        android:background="@drawable/gradient_background_flipped"
        android:contentDescription="@null" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/medium_viewer_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/medium_viewer_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_viewpager"
            app:navigationIcon="@drawable/ic_chevron_left_vector"
            app:titleMargin="@dimen/zero"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Medium"
            app:subtitleTextAppearance="@style/TextAppearance.AppCompat.Caption"
            tools:title="File"
            tools:subtitle="Date" />
    </com.google.android.material.appbar.AppBarLayout>
</RelativeLayout>
