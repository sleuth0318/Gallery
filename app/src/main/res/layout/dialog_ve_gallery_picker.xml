<?xml version="1.0" encoding="utf-8"?>
<!--
  Gallery-image sticker picker (Sticker tool → Gallery feature), compact
  dialog size with the reference folder-picker look (interface.jpg): "Gallery"
  title, capsule search ("Search folders"), 4-column grid of square rounded
  tiles (cover + name + count), accent Cancel/OK bottom-right, rounded dialog
  corners (window bg set in code). Folders are MediaStore image buckets
  filtered by the app's home visibility rules; tap one for its images, tap
  an image to mark it, OK confirms. Back arrow pops to the folder list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="16dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ve_picker_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ve_back"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_ve_back"
            android:visibility="gone" />

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/ve_picker_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/ve_picker_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Gallery" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/ve_picker_search"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ve_search_bg"
        android:drawableStart="@drawable/ic_ve_search"
        android:drawablePadding="8dp"
        android:drawableTint="#8E8E93"
        android:hint="@string/ve_picker_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@android:color/white"
        android:textColorHint="#8C8C90"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ve_picker_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/ve_picker_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.8"
            android:text="@string/ve_picker_empty"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/ve_picker_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_all_corners"
            android:gravity="center"
            android:minWidth="72dp"
            android:padding="12dp"
            android:text="@string/cancel"
            android:textSize="15sp" />

        <com.goodwy.commons.views.MyTextView
            android:id="@+id/ve_picker_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/ripple_all_corners"
            android:gravity="center"
            android:minWidth="72dp"
            android:padding="12dp"
            android:text="@string/ve_ok"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
